class Solution {
    public int[] topKFrequent(int[] nums, int k) { 
        HashMap<Integer, Integer> freq = new HashMap<>();
        for (int num : nums) {
            freq.put(num, freq.getOrDefault(num, 0) + 1);
        }
        Integer[] elements = freq.keySet().toArray(new Integer[0]);
        Arrays.sort(elements, (a, b) -> freq.get(b) - freq.get(a));
        int[] res = new int[k];
        for (int i = 0; i < k; i++) {
            res[i] = elements[i];
        }
        return res;
    }
}
